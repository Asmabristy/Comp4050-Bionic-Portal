# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/fitportal
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/fitportal
MONGO_URI=mongodb://127.0.0.1:27017/fitportal

# Signs login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-something-long-and-random
JWT_EXPIRES_IN=7d

# Where the FitSolver service lives.
SOLVER_URL=http://localhost:5000
SOLVER_TIMEOUT_MS=15000

# Set true to use the built-in fake solver instead of calling FitSolver.
# Lets you build and demo the whole Portal before Solver exists.
USE_MOCK_SOLVER=true

# Where the React app runs, for CORS.
WEB_ORIGIN=http://localhost:5173
